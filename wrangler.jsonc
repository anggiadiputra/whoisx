{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assetdev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  // nodejs_compat is required by OpenNext; global_fetch_strictly_public lets the app call RDAP servers
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above
      "binding": "WORKER_SELF_REFERENCE",
      "service": "assetdev"
    }
  ],
  "d1_databases": [
    {
      // Read by src/lib/prisma.ts. Schema changes: SQL files in migrations/, applied with `npm run db:migrate:*`
      "binding": "DB",
      "database_name": "assetdev",
      "database_id": "8862ea90-16a9-4624-a4f0-5d7b8d3f0c3e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://assetdev.naon.id"
  },
  "observability": {
    "enabled": true
  }
}
